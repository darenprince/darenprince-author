# VoxVector production diagnostics / durable storage
# Configure these as Render environment variables. Never commit real secrets.

VOXVECTOR_DIAGNOSTICS_ENABLED=true
VOXVECTOR_STORAGE_PROVIDER=supabase
VOXVECTOR_LOG_BUCKET=voxvector-logs
VOXVECTOR_STORAGE_TIMEOUT_SECONDS=2

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SIDE_SERVICE_ROLE_KEY

# Optional explicit origins for the browser client.
# CORS_ORIGINS=https://www.darenprince.com,https://voxvector.crownlabs.tech
