# Public Supabase project settings used by the React developer gate.
# These values are safe for browser use; never place service-role secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. Defaults to the canonical Render API.
VITE_VOXVECTOR_API_URL=https://voxvector.crownlabs.tech
