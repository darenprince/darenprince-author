# VoxVector production diagnostics / durable case storage
# Configure these as Render environment variables. Never commit real secrets.

VOXVECTOR_DIAGNOSTICS_ENABLED=true
VOXVECTOR_STORAGE_PROVIDER=supabase
VOXVECTOR_LOG_BUCKET=voxvector-logs
VOXVECTOR_MEDIA_BUCKET=voxvector-media
VOXVECTOR_MEDIA_MAX_BYTES=262144000
VOXVECTOR_STORAGE_TIMEOUT_SECONDS=5

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SIDE_SERVICE_ROLE_KEY

# Protected MANUAL Render deployment trigger used by the authenticated Developer Console/API bridge.
# Render production auto-deploy remains disabled. Store the full hook URL only in server-side Render configuration.
# A successful hook POST means only that the deployment request was accepted; verify the resulting Render deploy separately.
RENDER_DEPLOY_HOOK_URL=

# Explicit browser origins for the production Pages application and preserved API hostname.
CORS_ORIGINS=https://darenprince.com,https://www.darenprince.com,https://voxvector.crownlabs.tech
